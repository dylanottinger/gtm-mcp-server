# Demo mode returns realistic mock payloads and never calls vendor APIs.
DEMO_MODE=true

# HubSpot
HUBSPOT_ACCESS_TOKEN=your_private_app_access_token

# Clay
CLAY_API_KEY=your_clay_api_key
# Optional: override these if your Clay workspace uses Enterprise API paths or webhook-backed routes.
CLAY_BASE_URL=https://api.clay.com/v1
CLAY_PERSON_ENRICHMENT_PATH=/enrichment/person
CLAY_COMPANY_ENRICHMENT_PATH=/enrichment/company
CLAY_LOOKALIKE_PATH=/lookalikes

# Apollo
APOLLO_API_KEY=your_apollo_api_key

# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@yourdomain.com
SMTP_PASS=your_app_password
